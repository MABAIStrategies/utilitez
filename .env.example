# Copy this file to .env and fill in values for local development.
# Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5050

# Comma-separated list of allowed CORS origins.
# In production, set this to your deployed frontend domain.
ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" to use MySQL instead of the local JSON datasets.
USE_DB=false

# MySQL connection (only required when USE_DB=true)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=utilit_ez
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# ── Client ────────────────────────────────────────────────────────────────────
# Overrides the API base URL. Defaults to http://localhost:5050 in dev
# and /_/backend in production. Only set if you need a custom URL.
# VITE_API_BASE=http://localhost:5050
